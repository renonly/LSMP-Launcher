{
  "name": "esmp-launcher",
  "version": "1.4.2",
  "description": "ESMP",
  "main": "main.js",
  "author": "renonly",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:installer": "node installer/prepare.js && npm --prefix installer install && npm --prefix installer run dist",
    "dist:all": "npm run dist && npm run dist:installer"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "minecraft-launcher-core": "^3.18.2"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.esmp.launcher",
    "productName": "ESMP Launcher",
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ESMP Launcher",
      "language": "1046",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "artifactName": "ESMP-Launcher-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "renonly",
        "repo": "ESMP-Launcher",
        "releaseType": "release"
      }
    ]
  }
}
